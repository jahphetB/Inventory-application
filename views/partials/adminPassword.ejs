<div class="form-field admin-password-field">
	<label class="form-field__label" for="admin-password">Admin password (required)</label>
	<input
		class="form-field__input"
		id="admin-password"
		name="admin_password"
		type="password"
		autocomplete="current-password"
		maxlength="1024"
		aria-describedby="admin-password-help"
		required
	>
	<p class="form-field__help" id="admin-password-help">Only an administrator can make changes to the inventory.</p>
</div>
