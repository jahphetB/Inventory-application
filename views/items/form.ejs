<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title><%= title %></title>
		<link rel="stylesheet" href="/styles/main.css">
	</head>
	<body class="inventory-page">
		<%- include("../partials/navigation") %>

		<main class="item-form-page page-content page-content--narrow" id="main-content">
			<% const selectedCategory = categories.find((entry) => String(entry.id) === String(item.category_id)); %>
			<%- include("../partials/breadcrumbs", { breadcrumbs: [{ label: "Home", href: "/" }, ...(selectedCategory ? [{ label: selectedCategory.family_name, href: "/families/" + selectedCategory.family_slug }, { label: selectedCategory.name, href: "/categories/" + selectedCategory.id }] : []), ...(item.id ? [{ label: item.name, href: "/items/" + item.id }] : []), { label: title }] }) %>
			<header class="page-header">
				<p class="page-eyebrow">Instrument library</p>
				<h1 class="item-form-page__title page-title"><%= title %></h1>
			</header>

			<% if (errors.length > 0) { %>
				<div class="form-errors" role="alert">
					<p class="form-errors__heading">Please correct the following:</p>
					<ul class="form-errors__list">
						<% errors.forEach((error) => { %>
							<li class="form-errors__item"><%= error %></li>
						<% }); %>
					</ul>
				</div>
			<% } %>

			<form class="item-form form-panel" action="<%= action %>" method="post">
				<div class="form-field item-form__name-field">
					<label class="form-field__label" for="item-name">Name (required)</label>
					<input
						class="form-field__input"
						id="item-name"
						name="name"
						type="text"
						value="<%= item.name %>"
						required
					>
				</div>

				<div class="form-field item-form__brand-field">
					<label class="form-field__label" for="item-brand">Brand (required)</label>
					<input
						class="form-field__input"
						id="item-brand"
						name="brand"
						type="text"
						value="<%= item.brand %>"
						required
					>
				</div>

				<div class="form-field item-form__description-field">
					<label class="form-field__label" for="item-description">
						Description (optional)
					</label>
					<textarea
						class="form-field__input"
						id="item-description"
						name="description"
					><%= item.description %></textarea>
				</div>

				<div class="form-field item-form__price-field">
					<label class="form-field__label" for="item-price">
						Price in USD (required)
					</label>
					<input
						class="form-field__input"
						id="item-price"
						name="price"
						type="number"
						min="0"
						max="99999999.99"
						step="0.01"
						value="<%= item.price %>"
						required
					>
				</div>

				<div class="form-field item-form__stock-field">
					<label class="form-field__label" for="item-stock">
						Stock quantity (required)
					</label>
					<input
						class="form-field__input"
						id="item-stock"
						name="stock_quantity"
						type="number"
						min="0"
						max="2147483647"
						step="1"
						value="<%= item.stock_quantity %>"
						required
					>
				</div>

				<div class="form-field item-form__category-field">
					<label class="form-field__label" for="item-category">
						Category (required choice)
					</label>
					<select
						class="form-field__input"
						id="item-category"
						name="category_id"
						required
					>
						<option
							class="item-form__category-placeholder"
							value=""
							disabled
							<%= item.category_id === "" ? "selected" : "" %>
						>Choose a category</option>
						<option
							class="item-form__category-option"
							value="uncategorized"
							<%= item.category_id === "uncategorized" ? "selected" : "" %>
						>Uncategorized</option>
						<% categories.forEach((category) => { %>
							<option
								class="item-form__category-option"
								value="<%= category.id %>"
								<%= String(item.category_id) === String(category.id) ? "selected" : "" %>
							><%= category.family_name %> / <%= category.name %></option>
						<% }); %>
					</select>
				</div>

				<%- include("../partials/adminPassword") %>

				<div class="item-form__actions form-actions">
					<button class="item-form__submit button button--primary" type="submit">
						<%= submitLabel %>
					</button>
					<a class="item-form__cancel button button--secondary" href="<%= cancelUrl %>">Cancel</a>
				</div>
			</form>
		</main>
	</body>
</html>
