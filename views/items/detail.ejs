<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title><%= title %></title>
		<link rel="stylesheet" href="/styles/main.css">
	</head>
	<body class="inventory-page">
		<%- include("../partials/navigation") %>

		<main class="item-detail-page page-content page-content--narrow" id="main-content">
			<%- include("../partials/breadcrumbs", { breadcrumbs: [{ label: "Home", href: "/" }, ...(item.family_slug ? [{ label: item.family_name, href: "/families/" + item.family_slug }] : []), { label: item.category_name || "Uncategorized", href: item.category_id === null ? "/items/uncategorized" : "/categories/" + item.category_id }, { label: item.name }] }) %>
			<header class="item-detail-page__header page-header">
				<p class="page-eyebrow">Instrument details</p>
				<h1 class="item-detail-page__title page-title"><%= item.name %></h1>
				<div class="item-detail-page__actions">
					<a class="item-detail-page__edit-link button button--primary" href="/items/<%= item.id %>/edit">
						Edit instrument
					</a>
					<a class="item-detail-page__delete-link button button--danger" href="/items/<%= item.id %>/delete">
						Delete instrument
					</a>
				</div>
			</header>

			<dl class="item-details">
				<dt class="item-details__label item-details__brand-label">Brand</dt>
				<dd class="item-details__brand"><%= item.brand %></dd>

				<dt class="item-details__label item-details__description-label">
					Description
				</dt>
				<dd class="item-details__description">
					<%= item.description || "No description provided." %>
				</dd>

				<dt class="item-details__label item-details__price-label">Price</dt>
				<dd class="item-details__price">
					<%= priceFormatter.format(item.price) %>
				</dd>

				<dt class="item-details__label item-details__stock-label">In stock</dt>
				<dd class="item-details__stock"><%= item.stock_quantity %></dd>

				<dt class="item-details__label item-details__category-label">
					Category
				</dt>
				<dd class="item-details__category">
					<% if (item.category_id !== null) { %>
						<a class="item-details__category-link" href="/categories/<%= item.category_id %>">
							<%= item.category_name %>
						</a>
					<% } else { %>
						<a class="item-details__category-link" href="/items/uncategorized">
							Uncategorized
						</a>
					<% } %>
				</dd>
			</dl>
		</main>
	</body>
</html>
