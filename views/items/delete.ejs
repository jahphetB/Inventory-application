<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title><%= title %></title>
		<link rel="stylesheet" href="/styles/main.css">
	</head>
	<body class="inventory-page">
		<%- include("../partials/navigation") %>

		<main class="item-delete-page page-content page-content--narrow" id="main-content">
			<%- include("../partials/breadcrumbs", { breadcrumbs: [{ label: "Home", href: "/" }, ...(item.family_slug ? [{ label: item.family_name, href: "/families/" + item.family_slug }] : []), { label: item.category_name || "Uncategorized", href: item.category_id === null ? "/items/uncategorized" : "/categories/" + item.category_id }, { label: item.name, href: "/items/" + item.id }, { label: title }] }) %>
			<header class="page-header">
				<p class="page-eyebrow">Instrument library</p>
				<h1 class="item-delete-page__title page-title"><%= title %></h1>
			</header>

			<p class="item-delete-page__question">
				Delete <strong class="item-delete-page__item-name"><%= item.name %></strong>
				by <span class="item-delete-page__item-brand"><%= item.brand %></span>?
			</p>

			<p class="item-delete-page__warning">
				This permanently removes the instrument entry and its stock information.
				This action cannot be undone.
			</p>

			<form
				class="item-delete-form"
				action="/items/<%= item.id %>/delete"
				method="post"
			>
				<%- include("../partials/adminPassword") %>

				<div class="item-delete-form__actions form-actions">
					<button class="item-delete-form__submit button button--danger" type="submit">
						Delete instrument
					</button>
					<a class="item-delete-form__cancel button button--secondary" href="/items/<%= item.id %>">
						Cancel
					</a>
				</div>
			</form>
		</main>
	</body>
</html>
