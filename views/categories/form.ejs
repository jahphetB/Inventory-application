<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title><%= title %></title>
		<link rel="stylesheet" href="/styles/main.css">
	</head>
	<body class="inventory-page">
		<%- include("../partials/navigation") %>

		<main class="category-form-page page-content page-content--narrow" id="main-content">
			<header class="page-header">
				<p class="page-eyebrow">Collections</p>
				<h1 class="category-form-page__title page-title"><%= title %></h1>
				<p class="page-description">Give your instruments a collection of their own.</p>
			</header>

			<% if (errors.length > 0) { %>
				<div class="form-errors" role="alert">
					<p class="form-errors__heading">Please correct the following:</p>
					<ul class="form-errors__list">
						<% errors.forEach((error) => { %>
							<li class="form-errors__item"><%= error %></li>
						<% }); %>
					</ul>
				</div>
			<% } %>

			<form class="category-form form-panel" action="<%= action %>" method="post">
				<div class="form-field category-form__name-field">
					<label class="form-field__label" for="category-name">
						Name (required)
					</label>
					<input
						class="form-field__input"
						id="category-name"
						name="name"
						type="text"
						value="<%= category.name %>"
						required
					>
				</div>

				<div class="form-field category-form__description-field">
					<label class="form-field__label" for="category-description">
						Description (optional)
					</label>
					<textarea
						class="form-field__input"
						id="category-description"
						name="description"
					><%= category.description %></textarea>
				</div>

				<%- include("../partials/adminPassword") %>

				<div class="category-form__actions form-actions">
					<button class="category-form__submit button button--primary" type="submit">
						<%= submitLabel %>
					</button>
					<a class="category-form__cancel button button--secondary" href="<%= cancelUrl %>">Cancel</a>
				</div>
			</form>
		</main>
	</body>
</html>
