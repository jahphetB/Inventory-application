<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title><%= title %></title>
		<link rel="stylesheet" href="/styles/main.css">
	</head>
	<body class="inventory-page">
		<%- include("partials/navigation") %>

		<main class="home-page page-content" id="main-content">
			<header class="home-page__header">
				<h1 class="home-page__title page-title"><%= title %></h1>
			</header>

			<section class="family-section" aria-labelledby="family-heading">
				<div class="family-section__header category-section__header">
					<h2 class="family-section__heading section-heading" id="family-heading">Instrument families</h2>
					<p class="family-section__meta section-meta"><%= families.length %> families</p>
				</div>
				<ul class="family-list category-list">
					<% families.forEach((family) => { %>
						<li class="family-card category-card">
							<h3 class="family-card__heading category-card__heading"><a class="family-card__link category-card__link" href="/families/<%= family.slug %>"><%= family.name %></a></h3>
							<p class="family-card__count category-card__count"><%= family.category_count %> <%= family.category_count === 1 ? "category" : "categories" %> &middot; <%= family.item_count %> <%= family.item_count === 1 ? "instrument" : "instruments" %></p>
						</li>
					<% }); %>
				</ul>
			</section>
			<nav class="inventory-shortcuts" aria-label="Other inventory views">
				<a class="inventory-shortcuts__link" href="/items">All items</a>
				<a class="inventory-shortcuts__link" href="/items/uncategorized">Uncategorized (<%= uncategorizedCount %>)</a>
			</nav>
		</main>
	</body>
</html>
